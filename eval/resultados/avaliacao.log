{"data_hora": "2026-11-22T17:53:51.591+00:00", "nivel": "INFO", "evento": "resposta_modelo", "id": "231b1a42", "tentativa": 1, "tipo": "sql", "conteudo": "SELECT \n    (SUM(CASE WHEN strftime('%Y', data_pedido) = '2025' THEN valor_pedido ELSE 0 END) - \n     SUM(CASE WHEN strftime('%Y', data_pedido) = '2024' THEN valor_pedido ELSE 0 END)) * 100 / \n    SUM(CASE WHEN strftime('%Y', data_pedido) = '2024' THEN valor_pedido ELSE 0 END) AS crescimento_percentual\nFROM (\n    SELECT \n        p.id AS pedido_id,\n        SUM(ip.quantidade * ip.preco_unitario) AS valor_pedido\n    FROM \n        pedidos p\n    JOIN \n        itens_pedido ip ON p.id = ip.pedido_id\n    WHERE \n        p.status != 'cancelado'\n    GROUP BY \n        p.id\n);", "tempo_modelo_ms": 1654}
