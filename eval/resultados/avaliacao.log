{"data_hora": "2026-11-22T17:53:36.121+00:00", "nivel": "INFO", "evento": "resposta_modelo", "id": "97c1d99e", "tentativa": 1, "tipo": "sql", "conteudo": "SELECT p.nome, SUM(ip.quantidade) AS total_vendido\nFROM produtos p\nJOIN itens_pedido ip ON p.id = ip.produto_id\nJOIN pedidos pe ON ip.pedido_id = pe.id\nWHERE pe.status != 'cancelado'\nGROUP BY p.id\nORDER BY total_vendido DESC\nLIMIT 4;", "tempo_modelo_ms": 757}
{"data_hora": "2026-11-22T17:53:36.125+00:00", "nivel": "INFO", "evento": "consulta_executada", "id": "97c1d99e", "sql": "SELECT p.nome, SUM(ip.quantidade) AS total_vendido\nFROM produtos p\nJOIN itens_pedido ip ON p.id = ip.produto_id\nJOIN pedidos pe ON ip.pedido_id = pe.id\nWHERE pe.status != 'cancelado'\nGROUP BY p.id\nORDER BY total_vendido DESC\nLIMIT 4;", "linhas": 4, "truncado": false, "plano": ["SCAN ip", "SEARCH p USING INTEGER PRIMARY KEY (rowid=?)", "SEARCH pe USING INTEGER PRIMARY KEY (rowid=?)", "USE TEMP B-TREE FOR GROUP BY", "USE TEMP B-TREE FOR ORDER BY"]}
