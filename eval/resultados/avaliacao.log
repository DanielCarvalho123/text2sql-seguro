{"data_hora": "2026-11-22T17:52:30.423+00:00", "nivel": "INFO", "evento": "resposta_modelo", "id": "9376bb5c", "tentativa": 1, "tipo": "sql", "conteudo": "SELECT \n    (SUM(CASE WHEN strftime('%Y', data_pedido) = '2025' THEN quantidade * preco_unitario ELSE 0 END) - \n     SUM(CASE WHEN strftime('%Y', data_pedido) = '2024' THEN quantidade * preco_unitario ELSE 0 END)) * 100 / \n    SUM(CASE WHEN strftime('%Y', data_pedido) = '2024' THEN quantidade * preco_unitario ELSE 0 END) AS crescimento_percentual\nFROM \n    itens_pedido\nJOIN \n    pedidos ON itens_pedido.pedido_id = pedidos.id\nWHERE \n    strftime('%Y', data_pedido) IN ('2024', '2025') AND pedidos.status != 'cancelado';", "tempo_modelo_ms": 1536}
