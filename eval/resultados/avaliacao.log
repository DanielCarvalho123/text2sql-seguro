{"data_hora": "2026-11-22T17:52:31.102+00:00", "nivel": "INFO", "evento": "pergunta_recebida", "id": "6b932250", "pergunta": "Quanto cada cliente que comprou gastou, em média, considerando só pedidos não cancelados?", "modelo": "qwen2.5-coder:3b", "usar_esquema": true, "validar_sql": true}
{"data_hora": "2026-11-22T17:52:31.747+00:00", "nivel": "INFO", "evento": "resposta_modelo", "id": "6b932250", "tentativa": 1, "tipo": "sql", "conteudo": "SELECT c.nome, AVG(ip.quantidade * ip.preco_unitario) AS media_gasto\nFROM clientes c\nJOIN pedidos p ON c.id = p.cliente_id\nJOIN itens_pedido ip ON p.id = ip.pedido_id\nWHERE p.status != 'cancelado'\nGROUP BY c.nome;", "tempo_modelo_ms": 644}
{"data_hora": "2026-11-22T17:52:31.752+00:00", "nivel": "INFO", "evento": "consulta_executada", "id": "6b932250", "sql": "SELECT c.nome, AVG(ip.quantidade * ip.preco_unitario) AS media_gasto\nFROM clientes c\nJOIN pedidos p ON c.id = p.cliente_id\nJOIN itens_pedido ip ON p.id = ip.pedido_id\nWHERE p.status != 'cancelado'\nGROUP BY c.nome;", "linhas": 235, "truncado": false, "plano": ["SCAN ip", "SEARCH p USING INTEGER PRIMARY KEY (rowid=?)", "SEARCH c USING INTEGER PRIMARY KEY (rowid=?)", "USE TEMP B-TREE FOR GROUP BY"]}
